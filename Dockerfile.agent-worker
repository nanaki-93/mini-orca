FROM golang:1.27.3-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY cmd/agent-worker ./cmd/agent-worker
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /agent-worker ./cmd/agent-worker

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /agent-worker /agent-worker
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/agent-worker"]
CMD ["--help"]
